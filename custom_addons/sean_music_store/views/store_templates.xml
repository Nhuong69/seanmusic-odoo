<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" inherit_id="website.layout" priority="110" name="Sean Music - Khung cửa hàng">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="o_sean_music_store" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']/header" position="replace">
            <header id="top" t-if="not no_header" class="o_sean_music_store_header o_no_autohide_menu">
                <div class="o_sean_music_store_topline"><div class="o_sean_music_store_container"><span>Một nhạc cụ tốt. Một hành trình mới.</span><a href="/huong-dan-chon-dan">Lần đầu mua đàn cũ? Đọc hướng dẫn <span aria-hidden="true">↗</span></a></div></div>
                <div class="o_sean_music_store_container o_sean_music_store_header_main">
                    <a href="/" class="o_sean_music_store_logo" aria-label="Sean Music - Trang chủ"><span class="o_sean_music_store_mark">s<span>.</span></span><span>sean<span>music</span><small>NHẠC CỤ • ĐAM MÊ • KẾT NỐI</small></span></a>
                    <form action="/shop" method="get" role="search" class="o_sean_music_store_search"><i class="oi" data-icon="search" aria-hidden="true"/><input type="search" name="search" aria-label="Tìm kiếm nhạc cụ" placeholder="Bạn đang tìm cây đàn nào?" t-att-value="request.params.get('search', '')"/><button type="submit">Tìm kiếm</button></form>
                    <div class="o_sean_music_store_header_actions"><a href="/my" aria-label="Tài khoản"><i class="oi" data-icon="person" aria-hidden="true"/><span>Tài khoản</span></a><a href="/shop/cart" aria-label="Giỏ hàng"><i class="oi" data-icon="shopping_cart" aria-hidden="true"/><span>Giỏ hàng</span></a></div>
                </div>
                <nav class="o_sean_music_store_nav top_menu" aria-label="Điều hướng chính"><div class="o_sean_music_store_container"><a href="/shop" class="o_sean_music_store_nav_all"><i class="oi" data-icon="menu" aria-hidden="true"/> Tất cả nhạc cụ</a><a t-att-href="env.ref('sean_music_store.category_acoustic').website_url">Guitar mộc</a><a t-att-href="env.ref('sean_music_store.category_electric').website_url">Guitar điện</a><a t-att-href="env.ref('sean_music_store.category_bass').website_url">Guitar bass</a><a t-att-href="env.ref('sean_music_store.category_drum').website_url">Trống điện</a><a t-att-href="env.ref('sean_music_store.category_amp').website_url">Ampli &amp; thiết bị</a><a href="/huong-dan-chon-dan" class="o_sean_music_store_nav_guide">Góc người chơi ↗</a></div></nav>
            </header>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']/footer" position="replace">
            <footer id="bottom" t-if="not no_footer" class="o_sean_music_store_footer">
                <div class="o_sean_music_store_container o_sean_music_store_footer_grid"><div><a href="/" class="o_sean_music_store_footer_logo">sean<span>music.</span></a><p>Để nhạc cụ tiếp tục câu chuyện.<br/>Để bạn bắt đầu âm thanh của riêng mình.</p><span class="o_sean_music_store_footer_tag">Dành cho người yêu âm nhạc</span></div><div><h2>Khám phá</h2><a href="/shop">Tất cả nhạc cụ</a><a href="/shop?max_price=5000000">Nhạc cụ dưới 5 triệu</a><a href="/shop?order=publish_date+desc">Sản phẩm mới đăng</a></div><div><h2>Đồng hành cùng bạn</h2><a href="/huong-dan-chon-dan">Hướng dẫn chọn đàn cũ</a><a href="/chinh-sach">Mua hàng &amp; giao nhận</a><a href="/lien-he">Liên hệ tư vấn</a></div><div><h2>Sean Music</h2><a href="/ve-sean-music">Câu chuyện của chúng mình</a><a href="/my">Tài khoản &amp; đơn hàng</a><p>Trao đổi với cửa hàng để xác nhận tình trạng, phụ kiện và khả năng giao hàng của từng nhạc cụ.</p></div></div>
                <div class="o_sean_music_store_container o_sean_music_store_footer_bottom"><span>© <t t-out="datetime.date.today().year"/> Sean Music</span><span>Âm nhạc kết nối. Nhạc cụ tiếp nối.</span><span>Tiếng Việt · VND (₫)</span></div>
            </footer>
        </xpath>
    </template>

    <record id="category_acoustic" model="product.public.category"><field name="name">Guitar mộc</field><field name="sequence">10</field></record>
    <record id="category_electric" model="product.public.category"><field name="name">Guitar điện</field><field name="sequence">20</field></record>
    <record id="category_bass" model="product.public.category"><field name="name">Guitar bass</field><field name="sequence">30</field></record>
    <record id="category_drum" model="product.public.category"><field name="name">Trống điện</field><field name="sequence">40</field></record>
    <record id="category_amp" model="product.public.category"><field name="name">Ampli &amp; thiết bị</field><field name="sequence">50</field></record>
    <record id="category_service" model="product.public.category"><field name="name">Dịch vụ âm nhạc</field><field name="sequence">60</field></record>

    <template id="home" name="Sean Music - Nhạc cụ và đàn đã qua sử dụng">
        <t t-call="website.layout"><t t-set="title">Sean Music | Tìm nhạc cụ, tiếp nối đam mê</t>
            <div id="wrap" class="o_sean_music_store_home">
                <section class="o_sean_music_store_hero"><div class="o_sean_music_store_container o_sean_music_store_hero_grid"><div class="o_sean_music_store_hero_copy"><div class="o_sean_music_store_eyebrow"><span/> NHẠC CỤ CŨ. CẢM HỨNG MỚI.</div><h1>Đàn có câu chuyện.<br/><em>Bạn có giai điệu.</em></h1><p>Tìm một cây đàn hợp tay, một âm thanh hợp gu.<br/>Khám phá nhạc cụ và thiết bị cho hành trình âm nhạc của bạn.</p><div class="o_sean_music_store_hero_buttons"><a href="/shop" class="o_sean_music_store_button">Tìm nhạc cụ của bạn <span>↗</span></a><a href="/huong-dan-chon-dan" class="o_sean_music_store_button_text">Cách chọn đàn cũ <span>→</span></a></div><div class="o_sean_music_store_hero_note"><i class="oi" data-icon="tune" aria-hidden="true"/><span>Từ buổi tập đầu tiên đến sân khấu của riêng bạn.</span></div></div><div class="o_sean_music_store_hero_visual"><img src="/sean_music_store/static/src/img/guitar-wall.jpg" alt="Những cây guitar điện với nhiều kiểu dáng và màu sắc" width="1600" height="1067" fetchpriority="high"/><div class="o_sean_music_store_hero_caption"><span>ĐAM MÊ KHÔNG CÓ TUỔI</span><strong>Âm thanh hay<br/>luôn xứng đáng được tiếp nối.</strong><small>Ảnh cảm hứng · Unsplash</small></div><span class="o_sean_music_store_hero_stamp">CHƠI TIẾP<br/><b>ĐAM MÊ.</b></span></div></div></section>
                <div class="o_sean_music_store_values"><div class="o_sean_music_store_container"><span><i class="oi" data-icon="photo_camera" aria-hidden="true"/> Xem ảnh trước khi chọn</span><span><i class="oi" data-icon="tune" aria-hidden="true"/> Trao đổi tình trạng cụ thể</span><span><i class="oi" data-icon="chat_bubble" aria-hidden="true"/> Tìm nhạc cụ hợp nhu cầu</span><span><i class="oi" data-icon="refresh" aria-hidden="true"/> Tiếp nối vòng đời nhạc cụ</span></div></div>
                <section class="o_sean_music_store_section o_sean_music_store_container"><div class="o_sean_music_store_section_heading"><div><span class="o_sean_music_store_kicker">BẮT ĐẦU TỪ ÂM THANH BẠN YÊU</span><h2>Bạn muốn chơi gì?</h2></div><a href="/shop">Khám phá tất cả <span>↗</span></a></div><div class="o_sean_music_store_categories"><t t-foreach="[('acoustic', 'Guitar mộc', 'Mộc mạc, đầy cảm xúc', 'acoustic.jpg'), ('electric', 'Guitar điện', 'Chất riêng trong từng nốt', 'electric.jpg'), ('bass', 'Guitar bass', 'Giữ nhịp cho đam mê', 'bass.jpg'), ('drum', 'Trống điện', 'Bắt đầu nhịp điệu của bạn', 'drum.jpg'), ('amp', 'Ampli &amp; thiết bị', 'Đưa âm thanh đi xa hơn', 'amp.jpg')]" t-as="item"><a t-att-href="env.ref('sean_music_store.category_' + item[0]).website_url" class="o_sean_music_store_category"><div><img t-att-src="'/sean_music_store/static/src/img/' + item[3]" t-att-alt="item[1]" loading="lazy" width="250" height="210"/></div><h3><t t-out="item[1]"/><span>↗</span></h3><p t-out="item[2]"/></a></t></div></section>
                <section class="o_sean_music_store_featured"><div class="o_sean_music_store_container o_sean_music_store_section"><div class="o_sean_music_store_section_heading"><div><span class="o_sean_music_store_kicker">TÌM MỘT NGƯỜI BẠN MỚI</span><h2>Những cây đàn đáng khám phá</h2></div><a href="/shop">Xem toàn bộ cửa hàng ↗</a></div><div class="o_sean_music_store_price_tabs"><a href="/shop">Tất cả nhạc cụ</a><a href="/shop?max_price=5000000">Dưới 5 triệu</a><a href="/shop?min_price=5000000&amp;max_price=10000000">5 – 10 triệu</a><a href="/shop?min_price=10000000">Trên 10 triệu</a></div><div class="o_sean_music_store_cards"><t t-foreach="featured_products" t-as="instrument"><a t-att-href="instrument.website_url" class="o_sean_music_store_card"><div class="o_sean_music_store_card_photo"><img t-if="instrument.image_128" t-att-src="'/web/image/product.template/%s/image_512' % instrument.id" t-att-alt="instrument.name" loading="lazy" width="320" height="300"/><span t-else="" class="o_sean_music_store_photo_pending">Ảnh đang được bổ sung</span><span class="o_sean_music_store_card_badge" t-out="instrument._sean_condition_label()"/></div><div class="o_sean_music_store_card_info"><span class="o_sean_music_store_card_brand" t-out="instrument.public_categ_ids[:1].name or 'Nhạc cụ'"/><h3 t-out="instrument.name"/><strong t-out="instrument.list_price" t-options="{'widget':'monetary', 'display_currency':website.currency_id}"/><span class="o_sean_music_store_card_detail">Khám phá chi tiết <i class="oi" data-icon="arrow_forward" aria-hidden="true"/></span></div></a></t></div></div></section>
                <section class="o_sean_music_store_container o_sean_music_store_section o_sean_music_store_story"><div class="o_sean_music_store_story_image"><img src="/sean_music_store/static/src/img/playing.jpg" alt="Nghệ sĩ đang chơi guitar trong phòng thu - ảnh minh họa" loading="lazy" width="1200" height="800"/><span>MỖI NHẠC CỤ, MỘT HÀNH TRÌNH.</span></div><div class="o_sean_music_store_story_copy"><span class="o_sean_music_store_kicker">MUA ĐÀN CŨ, CHỌN BẰNG HIỂU BIẾT</span><h2>Cũ ở năm tháng.<br/>Mới ở cảm hứng.</h2><p>Một cây đàn phù hợp không nhất thiết phải là cây đàn mới. Điều quan trọng là cảm giác khi cầm trên tay và âm thanh khiến bạn muốn chơi tiếp.</p><ol><li><span>01</span><div><h3>Xem kỹ ngoại hình</h3><p>Quan sát thân, cần, phím đàn và ảnh các vị trí có dấu vết sử dụng.</p></div></li><li><span>02</span><div><h3>Nghe thử, hỏi thật rõ</h3><p>Trao đổi về âm thanh, linh kiện và các phụ kiện thực tế đi kèm.</p></div></li><li><span>03</span><div><h3>Chọn theo nhu cầu của bạn</h3><p>Ngân sách, thể loại và cảm giác chơi quan trọng hơn một cái tên.</p></div></li></ol><a href="/huong-dan-chon-dan" class="o_sean_music_store_button_dark">Đọc hướng dẫn chọn đàn <span>↗</span></a></div></section>
                <section class="o_sean_music_store_cta"><div class="o_sean_music_store_container"><div><span class="o_sean_music_store_kicker">CHƯA BIẾT BẮT ĐẦU TỪ ĐÂU?</span><h2>Kể chúng mình nghe về<br/>âm thanh bạn đang tìm.</h2><p>Thể loại bạn thích. Ngân sách bạn có. Nhạc cụ bạn muốn chơi.</p></div><a href="/lien-he" class="o_sean_music_store_button">Tìm người đồng hành <span>↗</span></a></div></section>
            </div>
        </t>
    </template>

    <template id="shop" inherit_id="website_sale.products" priority="110" name="Sean Music - Danh mục nhạc cụ">
        <xpath expr="//div[@id='wrap']" position="attributes"><attribute name="class" add="o_sean_music_store_catalog" separator=" "/></xpath>
        <xpath expr="//div[@id='o_wsale_container']" position="before"><section class="o_sean_music_store_catalog_banner"><div class="o_sean_music_store_container"><span class="o_sean_music_store_kicker">TÌM ÂM THANH CỦA RIÊNG BẠN</span><h1>Cửa hàng nhạc cụ</h1><p>Chọn theo loại đàn, tìm theo ngân sách. Một hành trình mới bắt đầu từ đây.</p></div></section><div class="o_sean_music_store_container o_sean_music_store_price_tabs"><span>Ngân sách của bạn:</span><a href="/shop?max_price=5000000">Dưới 5 triệu</a><a href="/shop?min_price=5000000&amp;max_price=10000000">5 – 10 triệu</a><a href="/shop?min_price=10000000">Trên 10 triệu</a><a href="/shop">Xem tất cả</a></div></xpath>
        <xpath expr="//div[hasclass('o_wsale_shop_title')]/h1" position="replace"><h2 class="h4-fs">Khám phá tất cả nhạc cụ</h2></xpath>
    </template>
    <template id="product_tile" inherit_id="website_sale.products_item" priority="110" name="Sean Music - Tình trạng trên thẻ sản phẩm"><xpath expr="//div[hasclass('o_wsale_product_information')]" position="inside"><div class="o_sean_music_store_tile_condition" t-out="product._sean_condition_label()"/></xpath></template>
    <template id="product_details" inherit_id="website_sale.product_title" priority="110" name="Sean Music - Thông tin tình trạng">
        <xpath expr="//h1" position="after"><div class="o_sean_music_store_condition"><span class="o_sean_music_store_kicker">THÔNG TIN NHẠC CỤ</span><strong t-out="product._sean_condition_label()"/><p t-out="product.sean_condition_notes or 'Vui lòng trao đổi với Sean Music để xác nhận ngoại hình, khả năng hoạt động và phụ kiện của sản phẩm trước khi đặt mua.'"/><a href="/lien-he">Hỏi thêm về sản phẩm ↗</a></div></xpath>
    </template>
    <template id="sort" inherit_id="website_sale.sort" name="Sean Music - Sắp xếp"><xpath expr="//t[@t-set='_sort_label']" position="replace"><t t-set="_sort_label">Sắp xếp</t></xpath></template>
    <template id="search" inherit_id="website_sale.search" name="Sean Music - Tìm nhạc cụ"><xpath expr="//t[@t-call='website.website_search_box_input']" position="attributes"><attribute name="placeholder.f">Tìm đàn, thương hiệu, model...</attribute></xpath></template>
    <template id="search_input" inherit_id="website.website_search_box_input" name="Sean Music - Ô tìm kiếm"><xpath expr="//t[@t-if='not placeholder']" position="replace"><t t-if="not placeholder" t-set="placeholder">Tìm nhạc cụ...</t></xpath></template>
    <template id="login_layout" inherit_id="sean_music_home.sean_music_login_layout" priority="120" name="Sean Music - Đăng nhập tiếng Việt"><xpath expr="//span[hasclass('sean_music_login_kicker')]" position="replace"><span class="sean_music_login_kicker">TÀI KHOẢN SEAN MUSIC</span></xpath></template>
    <template id="website_login_layout" inherit_id="sean_music_home.sean_music_website_login_layout" priority="120" name="Sean Music - Tài khoản cửa hàng"><xpath expr="//span[hasclass('sean_music_login_kicker')]" position="replace"><span class="sean_music_login_kicker">TÀI KHOẢN SEAN MUSIC</span></xpath><xpath expr="//div[hasclass('sean_music_login_card_header')]/p" position="replace"><p>Đăng nhập để theo dõi đơn hàng và kết nối với Sean Music.</p></xpath></template>
    <template id="quick_reorder" inherit_id="website_sale.quick_reorder_button" name="Sean Music - Mua lại"><xpath expr="//t[@t-set='quick_reorder_button_title']" position="replace"><t t-set="quick_reorder_button_title"><t t-if="website.is_public_user()">Đăng nhập để mua lại</t><t t-elif="not order_history">Chưa có sản phẩm đã mua để đặt lại.</t></t></xpath><xpath expr="//button[@id='quick_reorder_button']" position="replace"><button id="quick_reorder_button" type="button" class="btn btn-sm btn-link" data-bs-toggle="offcanvas" data-bs-target="#quick_reorder_sidebar" aria-controls="quick_reorder_sidebar" t-att-disabled="not order_history"><i class="oi me-2" data-icon="undo"/>Mua lại nhanh</button></xpath></template>
    <template id="quick_reorder_sidebar" inherit_id="website_sale.quick_reorder_sidebar" name="Sean Music - Đặt lại sản phẩm"><xpath expr="//h5[hasclass('offcanvas-title')]" position="replace"><h5 class="offcanvas-title">Mua lại nhanh</h5></xpath></template>
    <template id="save_for_later" inherit_id="website_sale.product_cart_lines" name="Sean Music - Lưu sản phẩm"><xpath expr="//button[hasclass('o_add_wishlist') and hasclass('btn-sm')]" position="replace"><button class="o_add_wishlist js_delete_product btn btn-link btn-sm p-0" t-att-data-product-id="line.product_id.id" t-att-data-product-template-id="line.product_id.product_tmpl_id.id">Lưu để xem sau</button></xpath></template>

    <template id="information_layout" name="Sean Music - Trang thông tin"><t t-call="website.layout"><div id="wrap" class="o_sean_music_store_information"><section class="o_sean_music_store_catalog_banner"><div class="o_sean_music_store_container"><span class="o_sean_music_store_kicker" t-out="info_kicker"/><h1 t-out="info_title"/><p t-out="info_description"/></div></section><div class="o_sean_music_store_container o_sean_music_store_information_body"><t t-out="0"/></div></div></t></template>
    <template id="huong_dan_chon_dan" name="Hướng dẫn chọn đàn cũ"><t t-call="sean_music_store.information_layout"><t t-set="title">Hướng dẫn chọn đàn cũ | Sean Music</t><t t-set="info_kicker">GÓC NGƯỜI CHƠI</t><t t-set="info_title">Cây đàn phù hợp bắt đầu từ những câu hỏi đúng.</t><t t-set="info_description">Một vài điều nên kiểm tra trước khi chọn nhạc cụ đã qua sử dụng.</t><div class="o_sean_music_store_guide_grid"><article><span>01 / NHU CẦU</span><h2>Bạn muốn chơi gì?</h2><p>Guitar mộc phù hợp để đệm hát và chơi không cần ampli. Guitar điện cho bạn nhiều lựa chọn âm sắc khi kết hợp thiết bị. Bass giữ phần nền của ban nhạc. Hãy chọn theo âm nhạc bạn thực sự muốn chơi.</p></article><article><span>02 / NGOẠI HÌNH</span><h2>Nhìn kỹ hơn một bức ảnh đẹp.</h2><p>Xin ảnh rõ thân, cần, mặt phím, ngựa đàn và đầu đàn. Hỏi về các vết nứt, dấu sửa chữa, độ mòn phím và tình trạng cần đàn. Ảnh minh họa của hãng không thay thế ảnh thực tế của món hàng.</p></article><article><span>03 / TRẢI NGHIỆM</span><h2>Nghe thử và chơi thử nếu có thể.</h2><p>Thử từng phím, nghe tiếng rè và kiểm tra khả năng giữ dây. Với đàn điện, kiểm tra từng pickup, núm chỉnh và cổng kết nối. Trao đổi trước về việc nghe thử hoặc nhận video kiểm tra.</p></article><article><span>04 / CHỐT MUA</span><h2>Rõ ràng trước khi đặt hàng.</h2><p>Xác nhận giá cuối cùng, phí giao hàng, phụ kiện đi kèm và điều kiện bảo hành, đổi trả bằng thông tin cụ thể. Không suy luận tình trạng sản phẩm chỉ từ tên model hoặc ảnh của hãng.</p></article></div><a href="/shop" class="o_sean_music_store_button_dark">Sẵn sàng tìm nhạc cụ <span>↗</span></a></t></template>
    <template id="ve_sean_music" name="Về Sean Music"><t t-call="sean_music_store.information_layout"><t t-set="title">Về Sean Music</t><t t-set="info_kicker">CÂU CHUYỆN CỦA CHÚNG MÌNH</t><t t-set="info_title">Âm nhạc kết nối. Nhạc cụ tiếp nối.</t><t t-set="info_description">Một nơi để bạn khám phá nhạc cụ và tìm âm thanh của riêng mình.</t><div class="o_sean_music_store_prose"><h2>Đồng hành với đam mê, từ những điều giản dị.</h2><p>Sean Music kết nối người chơi với đàn guitar, bass, trống điện và thiết bị âm nhạc. Chúng mình tin rằng chọn nhạc cụ nên bắt đầu từ nhu cầu thật, thông tin rõ ràng và một cuộc trò chuyện.</p><p>Với nhạc cụ đã qua sử dụng, mỗi món hàng có một câu chuyện riêng. Hãy trao đổi với cửa hàng về tình trạng của đúng sản phẩm bạn quan tâm, thay vì chỉ dựa vào thông số chung của model.</p><a href="/shop" class="o_sean_music_store_button_dark">Khám phá cửa hàng ↗</a></div></t></template>
    <template id="lien_he" name="Liên hệ Sean Music"><t t-call="sean_music_store.information_layout"><t t-set="title">Liên hệ tư vấn | Sean Music</t><t t-set="info_kicker">CÙNG TÌM ÂM THANH BẠN YÊU</t><t t-set="info_title">Chúng mình có thể giúp gì cho bạn?</t><t t-set="info_description">Chuẩn bị tên nhạc cụ, ngân sách và nhu cầu để cuộc trao đổi cụ thể hơn.</t><div class="o_sean_music_store_guide_grid"><article><span>TƯ VẤN CHỌN NHẠC CỤ</span><h2>Bắt đầu từ nhu cầu của bạn.</h2><p>Bạn đang học, đệm hát, thu âm hay biểu diễn? Hãy ghi lại thể loại yêu thích và khoảng ngân sách, rồi xem các lựa chọn trong cửa hàng.</p><a href="/shop">Chọn sản phẩm để trao đổi →</a></article><article><span>KÊNH LIÊN HỆ</span><h2>Thông tin cửa hàng</h2><t t-set="contact" t-value="website.company_id.sudo().partner_id"/><p t-if="contact.phone and '555' not in contact.phone"><a t-att-href="'tel:' + contact.phone" t-out="contact.phone"/></p><p t-if="contact.email and '.example.' not in contact.email"><a t-att-href="'mailto:' + contact.email" t-out="contact.email"/></p><p t-if="contact.street" t-field="contact.contact_address"/><p t-if="not contact.email or '.example.' in contact.email">Thông tin điện thoại, địa chỉ và email chính thức đang được cập nhật. Bạn có thể quản lý thông tin và theo dõi đơn hàng trong tài khoản.</p><a href="/my">Tài khoản của bạn →</a></article></div></t></template>
    <template id="chinh_sach" name="Mua hàng và giao nhận"><t t-call="sean_music_store.information_layout"><t t-set="title">Mua hàng và giao nhận | Sean Music</t><t t-set="info_kicker">THÔNG TIN TRƯỚC KHI MUA</t><t t-set="info_title">Chọn đúng đàn. Hiểu rõ điều kiện.</t><t t-set="info_description">Xác nhận các thông tin sau cho từng sản phẩm trước khi hoàn tất đơn hàng.</t><div class="o_sean_music_store_prose"><h2>Tình trạng và phụ kiện</h2><p>Tình trạng ngoại hình, sửa chữa và phụ kiện của nhạc cụ cũ có thể khác nhau giữa từng món. Nếu trang sản phẩm chưa có thông tin, hãy yêu cầu cửa hàng xác nhận và cung cấp ảnh thực tế.</p><h2>Giá và thanh toán</h2><p>Giá cửa hàng hiển thị bằng đồng Việt Nam (₫). Xem tổng tiền, thuế và các khoản phí được thể hiện trong giỏ hàng trước khi tiếp tục. Các phương thức thanh toán phụ thuộc cấu hình đang được cửa hàng cung cấp.</p><h2>Giao hàng</h2><p>Phí, thời gian và phạm vi giao hàng cần được xác nhận theo địa chỉ nhận hàng và loại nhạc cụ. Kiểm tra đóng gói và tình trạng món hàng khi nhận, đồng thời lưu lại ảnh hoặc video nếu có vấn đề.</p><h2>Bảo hành và đổi trả</h2><p>Chính sách cụ thể đang chờ cửa hàng xác nhận. Không mặc định nhạc cụ cũ có thời hạn bảo hành hay quyền đổi trả giống hàng mới; hãy yêu cầu điều kiện áp dụng cho đúng sản phẩm trước khi mua.</p></div></t></template>
