<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_plan_list" model="ir.ui.view">
        <field name="name">sean.music.commission.plan.list</field>
        <field name="model">sean.music.commission.plan</field>
        <field name="arch" type="xml">
            <list string="Commission Plans">
                <field name="name"/>
                <field name="base_type"/>
                <field name="default_rate"/>
                <field name="rule_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_commission_plan_form" model="ir.ui.view">
        <field name="name">sean.music.commission.plan.form</field>
        <field name="model">sean.music.commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_collaborator)d" type="action" class="oe_stat_button" icon="fa-users">
                            <field name="collaborator_ids" widget="statinfo" string="Collaborators"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Standard Collaborator Plan"/></h1></div>
                    <group>
                        <field name="base_type"/>
                        <field name="default_rate" widget="percentage"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Product Rules">
                            <field name="rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_category_id"/>
                                    <field name="rate" widget="percentage"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">sean.music.commission.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
