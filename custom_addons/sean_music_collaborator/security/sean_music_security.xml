<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_collaborator_user" model="res.groups">
        <field name="name">Collaborator User</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_collaborator_manager" model="res.groups">
        <field name="name">Collaborator Manager</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('sean_music_collaborator.group_collaborator_user')), Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
